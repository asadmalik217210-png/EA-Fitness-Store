PORT=5001
NODE_ENV=development
# Use a replica set URI in production; checkout transactions require it.
MONGODB_URI=mongodb+srv://saimbhatti20112_db_user:<db_password>@cluster0.iobcskl.mongodb.net/ea-fitness-clothing-store?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_NAME=ea_token

# Optional SMTP (password reset emails). If omitted, reset tokens are logged in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EA Fitness Clothing <noreply@eafitness.local>

# Payment abstraction. Use "mock" until a real gateway is configured.
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Local uploads (admin product images)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
